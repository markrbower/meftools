void findEvents( CaseSpecificVariables caseSpecVar, AlgorithmSpecificVariables algoSpecVar, AlgorithmSpecificFactory asf ) {
	char queryStr[256];

	DatabaseAccessor dba = asf.getDatabaseAccessor();
        MEFinfo info = asf.getMEFinfo();
        CircularBuffer circbuf = asf.getCircularBuffer();
        MEFconts mefConts = asf.getMEFconts();

        analysisFindPeaks peaks = analysisFindPeaks( caseSpecVar, algoSpecVar, info, mefConts, circbuf );
        cout << "analysisFindPeaks object constructed" << endl;
        peaks.compute();

}

